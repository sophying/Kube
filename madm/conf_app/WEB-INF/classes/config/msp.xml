<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- License Key Locations -->
	<msp>
		<system>
			<license>
				<key>WEB-INF/config/license.key</key>
				<cert>WEB-INF/config/license.cer</cert>
			</license>
			<ipfilter>
				<use>false</use>
				<!-- IP 목록이 엔터(Enter)로 구분된 파일의 절대 경로, 예: ${배포경로}/WEB-INF/classes/config/allowIP.txt
				샘플 경로: /app/morpheus/madm/WEB-INF/classes/config/allowIP.txt -->
				<config_path></config_path>
			</ipfilter>
		</system>
		<!-- 사용할 서비스를 지정합니다.-->
		<service>
			<mobile>true</mobile>
			<store>false</store>
			<push>true</push>
		</service>
	</msp>

	<admin>
		<!-- 초기 페이지로 메인 홈을 사용할지 여부 [true | false], 권한 관리 메뉴의 첫 페이지 설정보다 우선순위가 높음 -->
		<mainHomeFirstPageUse>false</mainHomeFirstPageUse>
		<!-- 메인 화면 썸네일 뷰의 가중치, 가중치가 높을수록 더 많은 썸네일이 표시됨 -->
		<mainHomeThumbNailView>
			<weight>
				<mobile>3</mobile>
				<push>2</push>
				<store>1</store>
			</weight>
			<!-- 검색 기준 기간 -->
			<searchPeriod>-7</searchPeriod>
		</mainHomeThumbNailView>

		<push>
			<receiver>
				<host>http://upmc-svc:8080</host>
			</receiver>
			<message>
				<absolute_path>/data/share/upmc/msg/</absolute_path>
				<imageFolderName>tempImage</imageFolderName>
				<htmlContentFolderName>html</htmlContentFolderName>
				<totalInfoFolderName>totalInfo</totalInfoFolderName>
				<csvFolderName>csv</csvFolderName>
				<absolute_path_web>http://test.world.sophy/msg/</absolute_path_web>
			</message>
			<!-- 예약 발송 스케줄러 동작 여부 설정 [true | false] -->
			<reserved_send>
				<use_yn>false</use_yn>
			</reserved_send>
			<!-- 기본 BadgeNo 설정 [0 | 1], 읽음 확인이 필요 없으면 0, 읽음확인 여부에 따라 카운트를 증가하려면 1 -->
			<default_badgeno>1</default_badgeno>
			<!-- Push 5.1 이상(5.5 제외)일 경우, Google Push의 UI Naming과 DB Object를 FCM으로 사용 -->
			<google_push_fcm>true</google_push_fcm>
		</push>
		<!-- size of divided compress-->
		<resource>
			<compress>
				<partition>
					<size>10000000</size>
				</partition>
			</compress>
			<!-- 사전 배포 기능 사용 여부 설정 -->
			<preDeploy>true</preDeploy>
		</resource>
		<!-- Admin Velocity Configuration-->
		<velocity>
			<charset>UTF-8</charset>
			<layout>
				layout/default.vm
				<cache>false</cache>
				<suffix>.vm</suffix>
				<contentType>text/html; charset=UTF-8</contentType>
			</layout>
			<template>
				<path>WEB-INF/views</path>
			</template>
		</velocity>
	</admin>


	<datasource>
		<type>jndi</type>
		<!-- 중요! 연결할 DB 종류와 동일하게 설정하세요. -->
		<dbtype>mysql</dbtype><!-- oracle, oracle9i, mssql, mysql, postgresql, edb-pas, db2, cubrid -->
		<dbtype_mobile>${datasource.dbtype}</dbtype_mobile>
		<dbtype_push>${datasource.dbtype}</dbtype_push>
		<dbtype_securepush>${datasource.dbtype}</dbtype_securepush>

		<jndiname>
			<msp>
				<mobile>jdbc/msp_${datasource.dbtype_mobile}</mobile>
				<push>jdbc/msp_${datasource.dbtype_push}</push>
				<securepush>jdbc/msp_${datasource.dbtype_securepush}</securepush>
			</msp>
		</jndiname>

		<mybatis>
			<msp>
				<mobile>
					<mapperLocation>WEB-INF/sqlmap/${datasource.dbtype_mobile}/**/*.xml</mapperLocation>
				</mobile>
				<push>
					<mapperLocation>WEB-INF/sqlmap/${datasource.dbtype_push}/**/*.xml</mapperLocation>
				</push>
				<securepush>
					<mapperLocation>WEB-INF/sqlmap/${datasource.dbtype_securepush}/**/*.xml</mapperLocation>
				</securepush>
			</msp>
		</mybatis>
	</datasource>

	<common>
		<security_mode>true</security_mode>
		<referer_check>true</referer_check>
		<uri_check>true</uri_check>
		<!-- 매우 중요!!! true로 설정하는 경우 web.xml에서 세션 리스너를 등록하세요. -->
		<loginLockDay>90</loginLockDay>
		<doubleloginchk>false</doubleloginchk>
		<loginLockCnt>5</loginLockCnt>
		<loginLockTime>1800</loginLockTime>
		<Content-Security-Policy>default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:;</Content-Security-Policy>
		<X-Content-Type-Options>nosniff</X-Content-Type-Options>
		<!-- 브라우저 XSS 보호 기능 사용 여부 -->
		<X-XSS-Protection>1</X-XSS-Protection>
		<!--<X-XSS-Protection>1, mode=block</X-XSS-Protection>-->
		<X-Frame-Options>SAMEORIGIN</X-Frame-Options>
		<charset>
			<utf8>
				<bytesize>3</bytesize>
			</utf8>
		</charset>
		<archive>
			<charset>UTF-8</charset>
		</archive>
		<dir>
			<!-- 중요! root는 OS에 따라 경로를 반드시 지정해야 함, 웹 디렉토리 내부가 아닌, 배포 파일이 저장될 물리적 디렉토리의 절대 경로 -->
			<root>/data/share</root>
			<files>${common.dir.root}/files/</files>
			<resource>${common.dir.root}/resource/</resource>
			<store>${common.dir.root}/store/</store>
			<fraudPrevent>${common.dir.root}/fraudPrevent/</fraudPrevent>
		</dir>
		<list>
			<row_size>10</row_size>
			<page_size>10</page_size>
		</list>
		<password>
			<changeday>90</changeday>
		</password>
		<!--<resources>
			<path>/adminweb/resources</path>
		</resources>
		<root>
			<path>/adminweb</path>
		</root>-->
	</common>

	<store>
		<!-- 앱스토어 등록 시, 기본 파일 업로드 외에 외부 URL을 통한 설치 방법 추가 -->
		<url_install>
			<use>true</use>
			<appstore_prefix>
				<android>https://play.google.com/store/apps/details?id=</android>
				<ios>https://apps.apple.com/app/id</ios>
			</appstore_prefix>
		</url_install>

		<service>
			<!-- 중요! 스토어에서 배포한 앱을 다운로드할 웹 어드민 URL,
			이 주소는 Admin 페이지 주소 + ContextRoot로 설정(admin에서는 불필요한 설정) -->
			<url>http://localhost:8580/store</url>
		</service>
		<path>
			<img>img</img>
			<bin>apk</bin>
		</path>
		<upload>
			<!-- 중요! 웹 서버의 루트 디렉토리로 설정, 스토어에서 배포할 앱이 저장될 물리적 디렉토리 경로
			즉, 웹 서버의 WEB-INF가 위치한 부모 디렉토리의 절대 경로를 지정 -->
			<absolute_path>/nas/morpheus/deploy/store</absolute_path>
		</upload>
		<empty_image_url>/img/empty.png</empty_image_url>
	</store>

	<server>
		<resource>
			<!-- 중요! 어드민 서버가 이중화된 경우, 배포 파일을 true로 설정한 후 아래 정보를 정확히 설정하세요. -->
			<sync>false</sync>
			<deploy>
				<splitSize>1000</splitSize>
			</deploy>
		</resource>
		<ftp>
			<target>
				<!-- <list>remote1,remote2</list>-->
				<list>remote2</list>
				<!--<remote1>
					<type>ftp</type>
					<hostname>localhost</hostname>
					<port>21</port>
					<id>uracle</id>
					<password></password>
					<remotepath>/resource/update/deploy/</remotepath>
					<fraudRemotepath>/fraudPrevent/</fraudRemotepath>
				</remote1>-->
				<remote2>
					<!-- type 종류: sftp, sftp2: 인증서 방식 (privatekey 파일 절대 경로 및 passphrase 설정 필요), sftp_enc, ftp_enc, ftp -->
					<type>sftp2</type>
					<hostname>localhost</hostname>
					<port>22</port>
					<id>uracle</id>
					<!--<password></password>-->
					<privatekey>/home/uracle/.ssh/id_rsa</privatekey>
					<passphrase></passphrase>
					<remotepath>/resource/update/deploy/</remotepath>
					<fraudRemotepath>/fraudPrevent/</fraudRemotepath>
				</remote2>
			</target>
		</ftp>
	</server>

	<pushserver>
		<resource>
			<!-- 중요! Push 서버가 이중화되었거나 웹 서버와 동기화할 때 사용하세요. -->
			<sync>false</sync>
		</resource>
		<ftp>
			<target>
				<list>remote1</list>
				<remote1>
					<type>sftp</type>
					<hostname>localhost</hostname>
					<port>22</port>
					<id>uracle</id>
					<password></password>
					<privatekey></privatekey>
					<!--<passphrase></passphrase>-->
					<remotepath>/nas/morpheus/push/msg/</remotepath>
				</remote1>
			</target>
		</ftp>
		<!-- CSV를 이용한 리시버 서버로의 대량 발송 시 CSV 파일 전송 -->
		<receiver>
			<csv_send_yn>false</csv_send_yn>
			<ftp>
				<target>
					<list>remote1</list>
					<remote1>
						<type>ftp</type>
						<hostname>localhost</hostname>
						<port>21</port>
						<id>uracle</id>
						<password></password>
						<!-- 경로 설정 시 반드시 마지막에 "/"를 붙이세요 -->
						<remotepath>/nas/morpheus/upmc/data/temp/</remotepath>
					</remote1>
				</target>
			</ftp>
		</receiver>

	</pushserver>

	<storeserver>
		<resource>
			<!-- 중요! 스토어에 등록된 앱 파일을 FTP 동기화 -->
			<sync>false</sync>
		</resource>
		<ftp>
			<target>
				<list>remote1</list>
				<remote1>
					<type>sftp</type>
					<hostname>localhost</hostname>
					<port>22</port>
					<id>uracle</id>
					<password></password>
					<remotepath>/nas/morpheus/app/admin/</remotepath>
				</remote1>
			</target>
		</ftp>
	</storeserver>

	<!-- 사용하지 않는 target은 삭제하거나 주석 처리하시고, target 구분자는 세미콜론(;)을 사용하세요.
		경로의 마지막에 반드시 "/"를 붙이세요. 앞 경로는 상관없으나, 마지막 디렉토리 real_res(운영), dev_res(개발)은 변경하지 마세요 -->
	<webplatform>
		<local>
			<use>false</use>
			<target>
				<list>local1,local2</list>
				<local1>
					<real_deploypath>/nas/morpheus/deploy/webplatform_res/real_res/</real_deploypath>
					<dev_deploypath>/nas/morpheus/deploy/webplatform_res/dev_res/</dev_deploypath>
				</local1>
				<local2>
					<real_deploypath>/nas/morpheus/deploy/webplatform_res2/real_res/</real_deploypath>
					<dev_deploypath>/nas/morpheus/deploy/webplatform_res2/dev_res/</dev_deploypath>
				</local2>
			</target>
		</local>
		<ftp>
			<use>false</use>
			<target>
				<list>remote1,remote2</list>
				<remote1>
					<type>ftp</type>
					<hostname>localhost</hostname>
					<port>21</port>
					<id>uracle</id>
					<password></password>
					<real_remotepath>/nas/morpheus/deploy/webplatform_res/real_res/</real_remotepath>
					<dev_remotepath>/nas/morpheus/deploy/webplatform_res/dev_res/</dev_remotepath>
				</remote1>
				<remote2>
					<type>sftp</type>
					<hostname>localhost</hostname>
					<port>22</port>
					<id>uracle</id>
					<password></password>
					<real_remotepath>/nas/morpheus/deploy/webplatform_res/real_res/</real_remotepath>
					<dev_remotepath>/nas/morpheus/deploy/webplatform_res/dev_res/</dev_remotepath>
				</remote2>
			</target>
		</ftp>
	</webplatform>

	<secure_push>
		<!-- 시큐어 푸시 전용 스타일 적용 여부 [true | false]
		true로 설정하면 시큐어 푸시용 스타일이 적용되며, 시큐어 푸시 전용 메인 홈이 사용됨 -->
		<useSecurePushStyle>false</useSecurePushStyle>

		<!-- 메시지 전송 요청을 처리하는 시큐어 푸시 게이트웨이 URL -->
		<msgSend_gwUrl>http://localhost:8080/secure-push-gw/api/securepush/sendMsg</msgSend_gwUrl>

		<!-- 발신 메시지 포워딩 요청을 처리하는 시큐어 푸시 게이트웨이 URL -->
		<msgForward_gwUrl>http://localhost:8080/secure-push-gw/api/securepush/forwardSentMsg</msgForward_gwUrl>

		<attach>
			<!-- 시큐어 푸시 첨부파일 최대 업로드 크기 (20MB) -->
			<max_upload_size>20971520</max_upload_size>
			<!-- 시큐어 푸시 첨부파일 임시 저장 디렉토리 경로 -->
			<temp_dir>${common.dir.root}/securepush/temp/</temp_dir>
			<!-- 게시판 첨부파일 설정-->
			<board>
				<upload_dir>/nas/morpheus/secure-push/upload/board/</upload_dir>
			</board>
		</attach>
		<!-- 아이콘 이미지 저장 디렉토리-->
		<icon_dir>/nas/morpheus/secure-push/icon/</icon_dir>
	</secure_push>
</configuration>
